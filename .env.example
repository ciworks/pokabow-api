PORT=3000
DATABASE_URL=postgres://postgres:password@localhost:5432/tilegame
# Generate a unique random value of at least 32 bytes for each deployment.
JWT_SECRET=
# Google OAuth web client credentials. Register this exact callback URL in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# HTTPS JSON mail relay: POST {to,subject,text} with Authorization: Bearer <key>.
# Email verification and passwordless sign-in return EMAIL_UNAVAILABLE until configured.
AUTH_EMAIL_WEBHOOK_URL=
AUTH_EMAIL_WEBHOOK_KEY=

# Comma-separated account email addresses allowed to edit achievements
ADMIN_EMAILS=

# Production Android/iOS rewarded ad unit IDs, comma-separated. Set each unit's
# AdMob server-side verification URL to https://YOUR_API/gems/rewarded-ad/callback.
ADMOB_REWARDED_AD_UNITS=
